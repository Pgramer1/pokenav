{
  "name": "pokenav",
  "version": "0.3.0",
  "description": "A Pokémon route-map style navigation component for React — a trail of circular sprite nodes connected by a dotted line.",
  "license": "MIT",
  "keywords": [
    "pokemon",
    "nav",
    "sidebar",
    "react",
    "navigation",
    "route",
    "pixel-art",
    "component"
  ],
  "homepage": "https://pokenav.devanshsoni.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pgramer1/pokenav.git",
    "directory": "packages/pallet"
  },
  "bugs": {
    "url": "https://github.com/Pgramer1/pokenav/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pokemon": {
      "types": "./dist/pokemon.d.ts",
      "import": "./dist/pokemon.js",
      "require": "./dist/pokemon.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./catalogue.json": "./catalogue.json",
    "./sprites/*": "./sprites/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "sprites",
    "catalogue.json",
    "sprite-import.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SPRITES-NOTICE.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-css-geometry.mjs && tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
